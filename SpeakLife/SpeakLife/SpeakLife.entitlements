<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Branch universal links, from the Branch dashboard's Deep Linking
	     Domains. Both are required: Branch issues a primary and an "-alternate"
	     domain and uses the pair so links still resolve when one domain is
	     already claimed by another app. Branch serves the
	     apple-app-site-association file for them itself, provided the Apple
	     Team ID and bundle id are filled in on the same dashboard page, so
	     nothing is hosted on our side.

	     `vqdga` is the random subdomain Branch auto-assigned. Branch allows the
	     app.link subdomain to be changed ONCE, ever. If it should read
	     `speaklife.app.link` instead, change it in the dashboard BEFORE any
	     link ships — afterwards every live link breaks and this entitlement
	     needs another App Store release to match. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:vqdga.app.link</string>
		<string>applinks:vqdga-alternate.app.link</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.franchiz.speaklife</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.Franchiz.SpeakLife</string>
	</array>
</dict>
</plist>
