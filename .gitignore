SpeakLife/Secrets.xcconfig

# Firebase CLI diagnostic output
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.firebase/

# Xcode per-user state
*.xcuserstate
xcuserdata/

# Backup files (e.g. project.pbxproj.bak left behind while editing)
