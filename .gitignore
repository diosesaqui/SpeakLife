# Claude Code session/plan files (keep committed skills, ignore the rest)
.claude/*
!.claude/skills/

# Local sender config (contains the broadcast secret)
scripts/send-message.env

# Swift Package Manager build artifacts for local packages (Packages/SpeakLifeKit)
Packages/*/.build/
Packages/*/.swiftpm/
__pycache__/
node_modules/
package-lock.json
