# Copy this file to send-message.env and fill in the two values below.
# send-message.env is gitignored so your secret is never committed.

# The deployed function URL. After you run:
#   firebase deploy --only functions:sendPersonalMessage
# the CLI prints a "Function URL" — paste it here. It looks like:
#   https://us-central1-<your-project-id>.cloudfunctions.net/sendPersonalMessage
MSG_FN_URL=""

# The same secret string you set with:
#   firebase functions:secrets:set MSG_BROADCAST_SECRET
MSG_BROADCAST_SECRET=""
