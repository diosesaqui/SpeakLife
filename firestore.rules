rules_version = '2';

// =====================================================================
// SpeakLife — Firestore security rules
// =====================================================================
// Covers the Warrior Room (Prayer Wall) v2 data model:
//   - prayerWall/{postId}                       (top-level posts)
//   - prayerWall/{postId}/agreements/{userId}   (one agreement per user)
//   - prayerWall/{postId}/flags/{userId}        (one moderation flag per user)
//   - users/{uid}                               (FCM token + deviceId field)
//
// Apply via:
//   1. Firebase Console → Firestore → Rules → paste this block, OR
//   2. firebase deploy --only firestore:rules
//
// Always use the Console's Rules Playground before deploying — a bad rule
// can lock the entire app out.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isPostOwner(postData) {
      // Posts created before authorUid was added (legacy v1 posts) have
      // no recorded owner — owner-gated writes are denied on those.
      return signedIn()
             && 'authorUid' in postData
             && postData.authorUid == request.auth.uid;
    }

    function isValidReactionType(value) {
      return value in ['standing', 'taking_ground',
                       'breakthrough_coming', 'already_done'];
    }

    // Fields a non-owner signed-in user may mutate on an existing post.
    // Crucially, this list does NOT include isHidden, isAnswered, or
    // reports — those are server- or owner-controlled now.
    function nonOwnerMutableFields() {
      return [
        'prayerCount',          // total reaction tally (kept in sync with map)
        'reactionCounts',       // v2 per-reaction map
        'notifiedMilestones'    // Cloud Function bookkeeping (writeable by
                                // the function via the admin SDK; no rule
                                // exception needed there since admin bypasses)
      ];
    }

    // Owner-only fields. The author can flip `isAnswered` to mark a
    // prayer request as answered; everything else they can also touch
    // (they can react to their own post, etc.).
    function ownerOnlyMutableFields() {
      return nonOwnerMutableFields().concat(['isAnswered']);
    }

    function onlyAllowsFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(allowed);
    }

    // ─── Warrior Room posts ───────────────────────────────────────────

    match /prayerWall/{postId} {
      // Public read of non-hidden posts is fine. The hidden filter is
      // belt-and-suspenders; clients already filter with
      // `where("isHidden", "==", false)`.
      allow read: if true;

      // Create: signed-in users only. We require authorUid to match the
      // signed-in user so the post has an enforceable owner from day one.
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 280;

      // Update splits into two paths:
      //   1. Post owner — may change isAnswered (mark as testimony) plus
      //      anything in the non-owner set.
      //   2. Non-owner signed-in user — may only touch reaction counts.
      // Neither path may touch isHidden or reports — those are
      // exclusively driven by the onPostFlagged Cloud Function via the
      // admin SDK (which bypasses these rules).
      allow update: if signedIn()
                    && (
                      (isPostOwner(resource.data)
                       && onlyAllowsFields(ownerOnlyMutableFields()))
                      || onlyAllowsFields(nonOwnerMutableFields())
                    );

      // The post author may delete their own post. Subcollections
      // (reactions/agreements/flags) become orphaned in storage — they're
      // no longer visible to anyone since the parent doc is gone, and a
      // cascade cleanup Cloud Function can be added later if storage cost
      // becomes a concern. Legacy posts (no authorUid) deny: rules-level
      // ownership cannot be established for them.
      allow delete: if isPostOwner(resource.data);

      // ─── Agreement chain ───────────────────────────────────────────
      // Doc id is the agreement author's auth uid → "one agreement per
      // user per post" is enforced by the rule layer.

      match /agreements/{userId} {
        allow read: if true;

        allow create: if signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId
                      && request.resource.data.displayName is string
                      && request.resource.data.displayName.size() > 0
                      && request.resource.data.displayName.size() <= 80
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 150
                      && request.resource.data.reactionType is string
                      && isValidReactionType(request.resource.data.reactionType);
                      // Note: we don't pin `timestamp == request.time` —
                      // the iOS client writes a Timestamp() captured on
                      // its own clock, which never matches the server's
                      // wall-clock exactly. If timestamp tampering ever
                      // becomes a real abuse vector, switch the model to
                      // @ServerTimestamp and re-enable that check.

        // Agreement text is immutable — no edits — but the author may
        // delete their own agreement (doc id == auth uid → simple match).
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // ─── Moderation flags ──────────────────────────────────────────
      // Doc id is the reporter's auth uid → one flag per user per post.
      // The onPostFlagged Cloud Function counts these and updates the
      // post's `reports` / `isHidden` fields. Clients never touch
      // `reports` or `isHidden` directly anymore.

      match /flags/{userId} {
        // Reporters cannot list other reports. Hidden surface area for
        // moderation: a future admin tool reads via admin SDK.
        allow read: if signedIn() && request.auth.uid == userId;

        allow create: if signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId
                      && request.resource.data.reason is string
                      && request.resource.data.reason.size() > 0
                      && request.resource.data.reason.size() <= 64;

        allow update, delete: if false;
      }
    }

    // ─── Users (FCM tokens etc.) ───────────────────────────────────────
    // The doc id is the auth uid. The deviceId is a FIELD on this doc so
    // Cloud Functions can resolve a deviceId → fcmToken via a query
    // (`where('deviceId', '==', ...)`). Previously we also wrote tokens
    // to `users/{deviceId}` which had no auth gate — that path is closed.

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ─── Bible Chat usage metering ─────────────────────────────────────
    // Written exclusively by the bibleChat Cloud Function via the admin SDK
    // (which bypasses these rules). Holds the free-message counter and token
    // usage totals — clients must never read or tamper with it.

    match /bibleChatUsage/{id} {
      allow read, write: if false;
    }

    // ─── Personalized declaration usage metering ───────────────────────
    // Written exclusively by the declarationMatch Cloud Function via the admin
    // SDK (which bypasses these rules). Holds the rolling rate-limit window and
    // token usage totals — a client that could write here could lift its own
    // rate limit, so it stays server-only.

    match /declarationMatchUsage/{id} {
      allow read, write: if false;
    }

    // ─── Scheduled broadcast messages ──────────────────────────────────
    // Written exclusively by the sendPersonalMessage Cloud Function and
    // delivered by processScheduledMessages via the admin SDK (which
    // bypasses these rules). Clients must never see or touch queued sends.

    match /scheduledMessages/{id} {
      allow read, write: if false;
    }

    // ─── Messages from SpeakLife (public broadcast timeline) ───────────
    // Written exclusively by the sendPersonalMessage / processScheduledMessages
    // Cloud Functions via the admin SDK whenever an allUsers broadcast is
    // delivered. Backs the "Messages" tab in the app's Community section:
    // anyone (including signed-out users) may read; clients never write.

    match /speakLifeMessages/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Inbox badge counter ───────────────────────────────────────────
    // A single doc (speakLifeMessagesMeta/summary) holding a monotonic
    // broadcast sequence number, incremented by the same Cloud Functions
    // that publish to the timeline above. The app watches it to badge the
    // Inbox without counting the collection. Public read like the messages
    // themselves; clients never write.

    match /speakLifeMessagesMeta/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
