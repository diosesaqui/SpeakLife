rules_version = '2';

// =====================================================================
// SpeakLife — Firestore security rules
// =====================================================================
// Covers the Warrior Room (Prayer Wall) v2 data model:
//   - prayerWall/{postId}                       (top-level posts)
//   - prayerWall/{postId}/agreements/{userId}   (one agreement per user)
//   - prayerWall/{postId}/flags/{userId}        (one moderation flag per user)
//   - users/{uid}                               (FCM token + deviceId field)
//
// ...and the Stand With Me (shared 7-day Enforcement) data model:
//   - standRooms/{roomId}                       (one doc per stand)
//   - standInvites/{code}                       (server-only)
//   - standNudges/{uid}                         (server-only)
//   - accountMerges/{ticket}                    (server-only)
//
// See docs/STAND_TOGETHER_SPEC.md.
//
// Apply via:
//   1. Firebase Console → Firestore → Rules → paste this block, OR
//   2. firebase deploy --only firestore:rules
//
// Always use the Console's Rules Playground before deploying — a bad rule
// can lock the entire app out.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // Signed in with a REAL identity — not an anonymous account.
    //
    // Stand With Me introduced anonymous auth so someone can accept a family
    // member's invite without hitting a Sign in with Apple wall. That silently
    // widened `signedIn()`, which every Prayer Wall write rule below is built
    // on: without this helper, the moment anonymous auth shipped, anyone could
    // post to the Prayer Wall — a surface that has always been gated behind
    // Sign in with Apple precisely because it carries free text to strangers.
    //
    // So: the Prayer Wall requires a full account. Stand rules and the user's
    // own document accept `signedIn()`, since a stand is invite-only, carries
    // no free text, and is the reason anonymous accounts exist at all.
    function isFullAccount() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isPostOwner(postData) {
      // Posts created before authorUid was added (legacy v1 posts) have
      // no recorded owner — owner-gated writes are denied on those.
      return isFullAccount()
             && 'authorUid' in postData
             && postData.authorUid == request.auth.uid;
    }

    function isValidReactionType(value) {
      return value in ['standing', 'taking_ground',
                       'breakthrough_coming', 'already_done'];
    }

    // Fields a non-owner signed-in user may mutate on an existing post.
    // Crucially, this list does NOT include isHidden, isAnswered, or
    // reports — those are server- or owner-controlled now.
    function nonOwnerMutableFields() {
      return [
        'prayerCount',          // total reaction tally (kept in sync with map)
        'reactionCounts',       // v2 per-reaction map
        'notifiedMilestones'    // Cloud Function bookkeeping (writeable by
                                // the function via the admin SDK; no rule
                                // exception needed there since admin bypasses)
      ];
    }

    // Owner-only fields. The author can flip `isAnswered` to mark a
    // prayer request as answered; everything else they can also touch
    // (they can react to their own post, etc.).
    function ownerOnlyMutableFields() {
      return nonOwnerMutableFields().concat(['isAnswered']);
    }

    function onlyAllowsFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(allowed);
    }

    // ─── Warrior Room posts ───────────────────────────────────────────

    match /prayerWall/{postId} {
      // Public read of non-hidden posts is fine. The hidden filter is
      // belt-and-suspenders; clients already filter with
      // `where("isHidden", "==", false)`.
      allow read: if true;

      // Create: full accounts only (never anonymous — see isFullAccount).
      // We require authorUid to match the signed-in user so the post has an
      // enforceable owner from day one.
      allow create: if isFullAccount()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 280;

      // Update splits into two paths:
      //   1. Post owner — may change isAnswered (mark as testimony) plus
      //      anything in the non-owner set.
      //   2. Non-owner signed-in user — may only touch reaction counts.
      // Neither path may touch isHidden or reports — those are
      // exclusively driven by the onPostFlagged Cloud Function via the
      // admin SDK (which bypasses these rules).
      allow update: if isFullAccount()
                    && (
                      (isPostOwner(resource.data)
                       && onlyAllowsFields(ownerOnlyMutableFields()))
                      || onlyAllowsFields(nonOwnerMutableFields())
                    );

      // The post author may delete their own post. Subcollections
      // (reactions/agreements/flags) become orphaned in storage — they're
      // no longer visible to anyone since the parent doc is gone, and a
      // cascade cleanup Cloud Function can be added later if storage cost
      // becomes a concern. Legacy posts (no authorUid) deny: rules-level
      // ownership cannot be established for them.
      allow delete: if isPostOwner(resource.data);

      // ─── Agreement chain ───────────────────────────────────────────
      // Doc id is the agreement author's auth uid → "one agreement per
      // user per post" is enforced by the rule layer.

      match /agreements/{userId} {
        allow read: if true;

        allow create: if isFullAccount()
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId
                      && request.resource.data.displayName is string
                      && request.resource.data.displayName.size() > 0
                      && request.resource.data.displayName.size() <= 80
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 150
                      && request.resource.data.reactionType is string
                      && isValidReactionType(request.resource.data.reactionType);
                      // Note: we don't pin `timestamp == request.time` —
                      // the iOS client writes a Timestamp() captured on
                      // its own clock, which never matches the server's
                      // wall-clock exactly. If timestamp tampering ever
                      // becomes a real abuse vector, switch the model to
                      // @ServerTimestamp and re-enable that check.

        // Agreement text is immutable — no edits — but the author may
        // delete their own agreement (doc id == auth uid → simple match).
        allow update: if false;
        allow delete: if isFullAccount() && request.auth.uid == userId;
      }

      // ─── Moderation flags ──────────────────────────────────────────
      // Doc id is the reporter's auth uid → one flag per user per post.
      // The onPostFlagged Cloud Function counts these and updates the
      // post's `reports` / `isHidden` fields. Clients never touch
      // `reports` or `isHidden` directly anymore.

      match /flags/{userId} {
        // Reporters cannot list other reports. Hidden surface area for
        // moderation: a future admin tool reads via admin SDK.
        allow read: if isFullAccount() && request.auth.uid == userId;

        allow create: if isFullAccount()
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId
                      && request.resource.data.reason is string
                      && request.resource.data.reason.size() > 0
                      && request.resource.data.reason.size() <= 64;

        allow update, delete: if false;
      }
    }

    // ─── Users (FCM tokens etc.) ───────────────────────────────────────
    // The doc id is the auth uid. The deviceId is a FIELD on this doc so
    // Cloud Functions can resolve a deviceId → fcmToken via a query
    // (`where('deviceId', '==', ...)`). Previously we also wrote tokens
    // to `users/{deviceId}` which had no auth gate — that path is closed.

    // Anonymous accounts are allowed here: an anonymous user still needs an
    // FCM token and a timezone on file for stand nudges to reach them.
    //
    // `write` was previously blanket-granted to the owner. It no longer is,
    // because two server-owned fields now live on this document:
    //   standPass     — the 7-day full-access grant issued by joinStand. A
    //                   client that can write it can mint itself premium.
    //   standRoomIds  — the list the app reads rooms by. A client that can
    //                   write it can point itself at an arbitrary room id.
    // Both are written exclusively by Cloud Functions via the admin SDK.
    function usersServerOnlyFields() {
      return ['standPass', 'standRoomIds'];
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
                    && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(usersServerOnlyFields());

      allow update: if signedIn()
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(usersServerOnlyFields());

      // Account deletion runs through the deleteAccount callable so stand
      // memberships are cleaned up in the same transaction.
      allow delete: if false;
    }

    // ─── Bible Chat usage metering ─────────────────────────────────────
    // Written exclusively by the bibleChat Cloud Function via the admin SDK
    // (which bypasses these rules). Holds the free-message counter and token
    // usage totals — clients must never read or tamper with it.

    match /bibleChatUsage/{id} {
      allow read, write: if false;
    }

    // ─── Scheduled broadcast messages ──────────────────────────────────
    // Written exclusively by the sendPersonalMessage Cloud Function and
    // delivered by processScheduledMessages via the admin SDK (which
    // bypasses these rules). Clients must never see or touch queued sends.

    match /scheduledMessages/{id} {
      allow read, write: if false;
    }

    // ─── Messages from SpeakLife (public broadcast timeline) ───────────
    // Written exclusively by the sendPersonalMessage / processScheduledMessages
    // Cloud Functions via the admin SDK whenever an allUsers broadcast is
    // delivered. Backs the "Messages" tab in the app's Community section:
    // anyone (including signed-out users) may read; clients never write.

    match /speakLifeMessages/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Inbox badge counter ───────────────────────────────────────────
    // A single doc (speakLifeMessagesMeta/summary) holding a monotonic
    // broadcast sequence number, incremented by the same Cloud Functions
    // that publish to the timeline above. The app watches it to badge the
    // Inbox without counting the collection. Public read like the messages
    // themselves; clients never write.

    match /speakLifeMessagesMeta/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ═══ Stand With Me ═════════════════════════════════════════════════
    //
    // A "stand" is one seven-day Enforcement run by 2-12 people at once.
    // Full model and rationale: docs/STAND_TOGETHER_SPEC.md.
    //
    // The invariant that makes these rules safe to keep tight: the room is a
    // MIRROR of each member's local EnforcementProgress, never the source of
    // truth. A write rejected here costs a dot on someone's week strip. It can
    // never cost a campaign day, so nothing below needs to be lenient to
    // protect user progress.

    function isStandMember(roomData) {
      return signedIn() && request.auth.uid in roomData.memberUids;
    }

    // The ONLY two top-level fields a client may affect. Everything else on a
    // room — the campaign, the roster, status, and every piece of notification
    // bookkeeping — is server-owned.
    //
    // Deliberately a whitelist, not a list of forbidden fields. A blacklist
    // leaves every field added later unprotected until someone remembers to
    // extend it, and the fields this feature keeps adding (nudge bookkeeping,
    // milestone state) are exactly the ones a client must never forge.
    function standClientWritableFields() {
      return ['members', 'lastActivityAt'];
    }

    // Day stamps are NOT validated here, deliberately.
    //
    // Two reasons. Rules have no date formatting, so bounding a "yyyy-MM-dd"
    // string against request.time means hand-building a zero-padded stamp out
    // of nested ternaries — fragile, and it would reject any write that sat in
    // the offline queue overnight, which is a real case since the whole point
    // is that someone can speak a declaration on a plane.
    //
    // And validating even the SHAPE would mean indexing the last element of
    // daysSpoken, which throws on an empty array. A rules evaluation error is
    // a denial, so that would reject legitimate writes that do not add a stamp
    // at all. An earlier revision defined such a helper and never called it;
    // the compiler's unused-function warning is what surfaced the gap.
    //
    // None of it is needed. The stamp drives the week strip and nothing else.
    // What protects progress is dayNumber monotonicity, the 0..7 cap, one new
    // stamp per write, the 14 entry cap, and the mirror invariant above — the
    // worst a clock-manipulated client achieves is misplaced dots on its own
    // row. The client drops malformed stamps at decode (StandRoom.init), which
    // is covered by a test.

    function standMemberEntry(data) {
      return data.members[request.auth.uid];
    }

    match /standRooms/{roomId} {

      // Members only. There is no client query path against this collection —
      // the app reads rooms by id from users/{uid}.standRoomIds — so a room id
      // alone reveals nothing to a non-member.
      allow read: if isStandMember(resource.data);

      // Rooms are minted by the createStand callable (the admin SDK bypasses
      // rules), which validates the embedded campaign before it is served to
      // other people's devices. Deletion runs through leaveStand/deleteAccount.
      allow create: if false;
      allow delete: if false;

      allow update: if isStandMember(resource.data)

        // Nobody rewrites the campaign, the roster, the status, or any of the
        // server's notification bookkeeping.
        && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(standClientWritableFields())

        // A member may only ever modify their OWN entry in the members map.
        // This is the rule that makes a 12-person room safe: everyone can
        // write to one document, and nobody can touch anyone else's row.
        && request.resource.data.members.diff(resource.data.members)
              .affectedKeys().hasOnly([request.auth.uid])

        // Progress is monotonic and bounded. Ground taken is never given back —
        // the same principle that already stops the daily checklist unticking
        // its Guard row.
        && standMemberEntry(request.resource.data).dayNumber is int
        && standMemberEntry(request.resource.data).dayNumber >= 0
        && standMemberEntry(request.resource.data).dayNumber <= 7
        && standMemberEntry(request.resource.data).dayNumber
             >= standMemberEntry(resource.data).dayNumber

        // At most one new day stamp per write, capped at 14 total (7 days plus
        // slack). Caps the blast radius of a client farming stamps to its own
        // row, and keeps the document small enough to stay a single read.
        && standMemberEntry(request.resource.data).daysSpoken.size()
             <= standMemberEntry(resource.data).daysSpoken.size() + 1
        && standMemberEntry(request.resource.data).daysSpoken.size() <= 14

        // The name and initial are rendered to other people, so bound them here
        // too, not only in the UI. A rule is the only layer an edited client
        // cannot skip.
        && standMemberEntry(request.resource.data).name is string
        && standMemberEntry(request.resource.data).name.size() <= 24
        && standMemberEntry(request.resource.data).initial is string
        && standMemberEntry(request.resource.data).initial.size() <= 2

        // Everything else on the entry is server-owned and must survive the
        // write untouched. Without this a member could set their OWN isOwner to
        // true and gain createStandInvite, or rewrite joinedAt to take
        // ownership on the next leaveStand handover. Bounding only the fields a
        // client is supposed to change leaves every field nobody thought about
        // wide open, which is the same blacklist mistake the top-level rule
        // already avoids.
        && standMemberEntry(request.resource.data).isOwner
             == standMemberEntry(resource.data).isOwner
        && standMemberEntry(request.resource.data).left
             == standMemberEntry(resource.data).left
        && standMemberEntry(request.resource.data).colorIndex
             == standMemberEntry(resource.data).colorIndex
        && standMemberEntry(request.resource.data).joinedAt
             == standMemberEntry(resource.data).joinedAt

        // Server clock, not the device's.
        && standMemberEntry(request.resource.data).lastSpokeAt == request.time
        && request.resource.data.lastActivityAt == request.time;
    }

    // ─── Invites, nudges, merge tickets ────────────────────────────────
    //
    // Closed to clients entirely.
    //
    // standInvites is the important one: if a client could read it, an eight
    // character code could be probed for validity offline and enumerated.
    // Redemption is the joinStand callable, which throttles attempts per uid
    // and audits them. Nudge scheduling and account-merge tickets are pure
    // server bookkeeping and a client has no business reading either.

    match /standInvites/{code}    { allow read, write: if false; }
    match /standNudges/{uid}      { allow read, write: if false; }
    match /accountMerges/{ticket} { allow read, write: if false; }
  }
}
